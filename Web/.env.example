# Supabase — same project as the MealMind app.
# Apply migration: MealMind/App/RecipeApp/supabase/migrations/20260507120000_waitlist_signups.sql
# (Supabase Dashboard → SQL Editor → paste → Run)
#
# Local dev: if you skip this file, `next.config.ts` loads MealMind/App/RecipeApp/.env
# (EXPO_PUBLIC_SUPABASE_*). Production (e.g. Vercel): set the vars below in the host UI.
#
# Prefer server-only names so keys are not exposed to the browser bundle:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
#
# Also accepted: NEXT_PUBLIC_SUPABASE_* or EXPO_PUBLIC_SUPABASE_* (same values as the mobile app).

# Optional: YouTube video id only (e.g. dQw4w9WgXcQ) for the landing “Watch” section embed.
# NEXT_PUBLIC_LANDING_YOUTUBE_ID=
