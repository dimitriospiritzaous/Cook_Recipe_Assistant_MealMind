# Supabase — same project as the MealMind app. Required for POST /api/waitlist.
#
# Migration (run once in Supabase → SQL Editor): Web/supabase/migrations/20260507120000_waitlist_signups.sql
# (copy SQL from `create table` through `notify pgrst`; do not paste a file path into the editor).
#
# Local dev: `next.config.ts` can load MealMind/App/RecipeApp/.env when Web/.env.local is absent.
#
# Vercel: Project → Settings → Environment Variables → add BOTH for Production (and Preview if needed):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
# Then redeploy. Vercel does not read the MealMind folder, so these must be set on the host.
#
# Prefer server-only names so keys are not exposed to the browser bundle:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
#
# Also accepted: NEXT_PUBLIC_SUPABASE_* or EXPO_PUBLIC_SUPABASE_* (same values as the mobile app).

# Optional: YouTube video id only (e.g. dQw4w9WgXcQ) for the landing “Watch” section embed.
# NEXT_PUBLIC_LANDING_YOUTUBE_ID=
